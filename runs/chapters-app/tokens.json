{
  "$description": "DTCG Format tokens for Chapters-app. Targets Community Group Draft of 30 July 2026. Note: dimension requires value/unit object (px/rem only). Color shape uses flat hex $value due to draft flux.",
  "color": {
    "$type": "color",
    "primary": {
      "base": {
        "$value": "#5B8DEF",
        "$description": "oklch(65% 0.15 255) - Primary Action"
      },
      "on-base": {
        "$value": "#FFFFFF",
        "$description": "WCAG > 5.6:1"
      }
    },
    "ai-accent": {
      "base": {
        "$value": "#3FB8AE",
        "$description": "oklch(72% 0.13 180) - AI / MCP Indicator"
      },
      "on-base": {
        "$value": "#070A0F",
        "$description": "WCAG > 6.8:1"
      }
    },
    "surface": {
      "substrate": {
        "$value": "#070A0F",
        "$description": "oklch(12% 0.015 250) - Deep Obsidian"
      },
      "on-substrate": {
        "$value": "#E2E8F4",
        "$description": "oklch(93% 0.015 240) - 16.2:1 ratio"
      },
      "elevated": {
        "$value": "#0F141F",
        "$description": "oklch(17% 0.02 245) - Card level"
      },
      "on-elevated": {
        "$value": "#E2E8F4",
        "$description": "14.1:1 ratio"
      },
      "muted": {
        "$value": "#161D2B",
        "$description": "oklch(20% 0.025 245) - Muted Fill"
      },
      "on-muted": {
        "$value": "#8B9BB4",
        "$description": "oklch(68% 0.03 240) - 5.3:1 ratio"
      }
    },
    "border": {
      "base": {
        "$value": "#1C2433",
        "$description": "oklch(24% 0.03 245)"
      },
      "focus": {
        "$value": "#3FB8AE",
        "$description": "AI Teal for focus rings"
      }
    },
    "surface-light": {
      "substrate": {
        "$value": "#F9FAFB",
        "$description": "Vellum light"
      },
      "on-substrate": {
        "$value": "#111827",
        "$description": "Dark text"
      },
      "elevated": {
        "$value": "#FFFFFF",
        "$description": "Card level"
      },
      "on-elevated": {
        "$value": "#111827",
        "$description": "Dark text"
      },
      "muted": {
        "$value": "#F3F4F6",
        "$description": "Muted Fill"
      },
      "on-muted": {
        "$value": "#4B5563",
        "$description": "Muted text"
      }
    },
    "border-light": {
      "base": {
        "$value": "#E5E7EB",
        "$description": "Light border"
      },
      "focus": {
        "$value": "#3FB8AE",
        "$description": "AI Teal for focus rings"
      }
    }
  },
  "space": {
    "1": {
      "$value": {
        "value": 4,
        "unit": "px"
      }
    },
    "2": {
      "$value": {
        "value": 8,
        "unit": "px"
      }
    },
    "3": {
      "$value": {
        "value": 16,
        "unit": "px"
      }
    },
    "4": {
      "$value": {
        "value": 24,
        "unit": "px"
      }
    },
    "5": {
      "$value": {
        "value": 32,
        "unit": "px"
      }
    },
    "6": {
      "$value": {
        "value": 48,
        "unit": "px"
      }
    },
    "7": {
      "$value": {
        "value": 64,
        "unit": "px"
      }
    },
    "$type": "dimension",
    "base": {
      "$value": {
        "value": 4,
        "unit": "px"
      }
    }
  },
  "radius": {
    "$type": "dimension",
    "sm": {
      "$value": {
        "value": 2,
        "unit": "px"
      }
    },
    "md": {
      "$value": {
        "value": 4,
        "unit": "px"
      }
    },
    "lg": {
      "$value": {
        "value": 8,
        "unit": "px"
      }
    }
  },
  "motion": {
    "duration": {
      "$type": "duration",
      "instant": {
        "$value": {
          "value": 0,
          "unit": "ms"
        }
      },
      "fast": {
        "$value": {
          "value": 100,
          "unit": "ms"
        }
      },
      "enter": {
        "$value": {
          "value": 240,
          "unit": "ms"
        }
      },
      "exit": {
        "$value": {
          "value": 160,
          "unit": "ms"
        }
      }
    },
    "easing": {
      "$type": "cubicBezier",
      "aerospace": {
        "$value": [
          0.16,
          1,
          0.3,
          1
        ]
      },
      "linear": {
        "$value": [
          0,
          0,
          1,
          1
        ]
      }
    },
    "transition": {
      "$type": "transition",
      "drawer-enter": {
        "$value": {
          "duration": "{motion.duration.enter}",
          "delay": {
            "value": 0,
            "unit": "ms"
          },
          "timingFunction": "{motion.easing.aerospace}"
        },
        "$description": "Modular drawer slide in"
      },
      "drawer-exit": {
        "$value": {
          "duration": "{motion.duration.exit}",
          "delay": {
            "value": 0,
            "unit": "ms"
          },
          "timingFunction": "{motion.easing.aerospace}"
        },
        "$description": "Modular drawer slide out"
      },
      "hover-snap": {
        "$value": {
          "duration": "{motion.duration.fast}",
          "delay": {
            "value": 0,
            "unit": "ms"
          },
          "timingFunction": "{motion.easing.linear}"
        },
        "$description": "Button hover effects"
      }
    }
  }
}