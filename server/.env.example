# Every environment variable this app reads, in one place.
#
# Two ways to use it:
#   - docker compose  →  copy to `.env` at the REPO ROOT (compose reads
#     that file; see docker-compose.yml, which passes each name through
#     only when it is actually set).
#   - running the server directly  →  copy to `server/.env` and start it
#     with `node --env-file=.env --import tsx src/index.ts`. Nothing in
#     the app loads a .env file by itself; it reads the process
#     environment.
#
# Every value has a dev-friendly default in server/src/config.ts. The
# ones that are DANGEROUS to leave at their default are marked ⚠ below.

# --- Core ---
NODE_ENV=production
# The only port. The Yjs collaboration relay is attached to this same
# HTTP server and answers websocket upgrades at /collab, so a reverse
# proxy in front needs exactly one upstream — just pass the Upgrade and
# Connection headers through on /collab, and give it a long read timeout
# (Yjs sockets are long-lived and often idle).
PORT=3000
DATABASE_URL=postgres://chapters:chapters@localhost:5432/chapters
# Built client to serve from this process. Defaults to ../../client/dist
# relative to server/src, which is where both the repo layout and the
# Docker image put it — override only if you build the client elsewhere.
# A missing directory is not an error: the server then serves the API
# only, exactly as it did before it could serve a UI.
# CLIENT_DIST=
# ⚠ WHERE THE NOTES ARE. Vault content is OKF markdown FILES ON DISK,
# not rows in Postgres — plus local-path repository clones and the
# embedding model cache. A database backup does not back this up, and
# the default ('./data', relative to the working directory) lands inside
# a container's writable layer, where a redeploy destroys it. Point this
# at a mounted volume. docker-compose.yml uses /data/chapters.
DATA_DIR=/data/chapters
LOCAL_REPOS_ROOT=/data/chapters/local-repos

# --- Email ⚠ THE MOST DANGEROUS SETTING IN THIS FILE ---
# With SMTP_HOST unset, server/src/email/mailer.ts does not send mail.
# It pushes each message onto an in-process array and returns success.
#
# In production that means signup verification and password reset APPEAR
# TO WORK — 200 responses, "check your email" in the UI — and no message
# is ever delivered, to anyone, with no error in any log. New users can
# never verify their address; locked-out users can never reset their
# password. Nothing surfaces the failure. Set this before real users.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=chapters@localhost

# --- Secrets ---
# ⚠ 32 bytes as 64 hex characters: openssl rand -hex 32
# Encrypts private-repository git credentials and webhook secrets at
# rest. Without it those cannot be stored at all — connecting a private
# repo or a webhook fails. There is no rotation story and no way to
# recover data encrypted under a lost key, so generate it and back it up
# BEFORE you need it.
CREDENTIALS_ENCRYPTION_KEY=
# One-time instance-setup token. LEAVE THE NAME UNSET (not set to an
# empty string) to have one generated and printed to the boot log on
# first run — bootstrap.ts uses `?? generateToken()`, and `??` does not
# catch '', so an empty value would become the actual setup token.
SETUP_TOKEN=

# --- Embeddings ---
# 'local' = real ONNX bge-small on CPU, self-hosted, content never
# leaves the instance (the first request downloads the model, so the
# process needs outbound network once). 'fake' = deterministic stub for
# tests: search and graph relevance are meaningless with it. Defaults to
# 'local' when NODE_ENV=production.
EMBEDDINGS=local
SEMANTIC_THRESHOLD=0.75
SEMANTIC_K=8

# --- Repository ingestion tuning ---
POLL_INTERVAL_MS=300000
WEBHOOK_STALE_THRESHOLD_MS=600000

# --- Collaboration / MCP / export tuning ---
COLLAB_DEBOUNCE_MS=2000
MCP_RATE_LIMIT=120
EXPORT_LINK_TTL_HOURS=24

# --- CORS ---
# Comma-separated origins allowed to call the API cross-origin. Leave
# unset for same-origin only, which is the right answer when the UI is
# served by this same process (it is, whenever client/dist is present)
# or reverse-proxied under the same domain.
CORS_ORIGIN=

# --- Used by docker-compose.yml only, not by the server ---
# Host port to publish the app on (container side is always 3000).
APP_PORT=3000
POSTGRES_USER=chapters
POSTGRES_PASSWORD=chapters
POSTGRES_DB=chapters
# Host port for the database. Published for local dev and the test
# suite; drop the mapping in docker-compose.yml on a production host.
POSTGRES_PORT=5432
